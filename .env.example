# Copy to .env for local runs. On GitHub these go in Settings → Secrets and variables → Actions.

# ---- Shopify (Dev Dashboard app installed on the Aoun store) ----
SHOPIFY_STORE_DOMAIN=aoun-collection-new.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional alternative to Client ID/Secret: a ready-made Admin API token (shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Optional: pin an API version (default 2026-07)
# SHOPIFY_API_VERSION=2026-07

# ---- Optional AI "today's priorities" brief (free Gemini key from aistudio.google.com) ----
GEMINI_API_KEY=
# GEMINI_MODEL=   (leave empty: a working model is picked automatically)

# ---- Email (Gmail: turn on 2-step verification, then create an App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=Aoun Store Report <youremail@gmail.com>
# Comma-separated — everyone who should get the 10am email
MAIL_TO=owner@example.com,storeteam@example.com
MAIL_CC=
